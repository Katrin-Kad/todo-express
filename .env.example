# Скопируйте в .env. Настоящие токены и пароли храните только в .env и на хостинге.
PORT=3000
MOODLE_LOGIN=katerina
MOODLE_FULL_NAME="Екатерина Кадушкина"

# Сгенерировать: openssl rand -hex 24
API_TOKEN=

# Supabase → Connect → Session pooler. Подставьте хост, project ref и пароли.
# DATABASE_ADMIN_URL нужен только локально, для db:init и db:role.
DATABASE_ADMIN_URL=
# DATABASE_URL — та же строка, но с пользователем todo_app.PROJECT_REF и его паролем.
DATABASE_URL=
# Отдельная строка с пользователем todo_reviewer.PROJECT_REF для локального npm test.
TEST_REVIEWER_URL=

DB_SCHEMA=todo
DB_SSL=verify-full
# Сертификат из Supabase → Database → Settings → SSL Configuration.
DB_SSL_CA_FILE=./supabase-ca.crt
# Для локальной БД без TLS укажите DB_SSL=disable.
